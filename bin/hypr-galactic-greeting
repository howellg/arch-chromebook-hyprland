#!/usr/bin/env python3
"""Compact faction-aware console startup panel. Reads only local system data."""
from pathlib import Path
import datetime
import os
import shutil
import socket
import sys

PROFILES={
    "imperial":("IMPERIAL COMMAND","FLEET OPERATIONS","ed6664","aab7c7"),
    "sith":("SITH ARCHIVES","KORRIBAN / RESTRICTED RECORDS","ed4257","c49da9"),
    "rakatan":("RAKATAN RESEARCH","ANCIENT SYSTEMS / STAR MAP","64d5df","97b9c5"),
}
def uptime():
    try:
        seconds=int(float(Path("/proc/uptime").read_text().split()[0]))
        hours,rem=divmod(seconds,3600)
        return f"{hours}h {rem//60:02d}m" if hours else f"{rem//60}m"
    except (OSError,ValueError,IndexError):return "—"
def memory():
    try:
        info={}
        for line in Path("/proc/meminfo").read_text().splitlines():
            if line.startswith(("MemTotal:","MemAvailable:")):
                k,v=line.split(":",1)
                info[k]=int(v.split()[0])
        used=(info["MemTotal"]-info["MemAvailable"])/1048576
        total=info["MemTotal"]/1048576
        return f"{used:.1f}/{total:.1f}G"
    except (OSError,ValueError,KeyError,IndexError):return "—"
def battery():
    try:
        for source in Path("/sys/class/power_supply").glob("BAT*"):
            capacity=int((source/"capacity").read_text().strip())
            return f"{capacity}%"
    except (OSError,ValueError):pass
    return "—"
def paint(value,hexcode,bold=False):
    if not sys.stdout.isatty() or os.getenv("NO_COLOR"):
        return value
    r,g,b=tuple(int(hexcode[i:i+2],16) for i in (0,2,4))
    return f"\x1b[{1 if bold else 22};38;2;{r};{g};{b}m{value}\x1b[0m"

def main():
    key=os.getenv("STARWARS_TERMINAL_PROFILE","imperial").lower()
    title,subtitle,accent,muted=PROFILES.get(key,PROFILES["imperial"])
    width=max(48,min(shutil.get_terminal_size((80,24)).columns-2,76))
    host=socket.gethostname().split(".")[0].upper()
    one=f" ◆ {title} "
    top="╭─"+one+"─"*max(0,width-len(one)-3)+"╮"
    bottom="╰"+"─"*(width-2)+"╯"
    pad=lambda s:"│ "+s[:width-4].ljust(width-4)+" │"
    info=f"ARCH LINUX  •  UP {uptime()}  •  RAM {memory()}  •  BAT {battery()}"
    tips="READY   /   galactic help   •   galactic info"
    print(paint(top,accent,bold=True))
    print(paint(pad(subtitle),muted))
    print(paint(pad(info),"d0d8df"))
    print(paint(pad(tips),muted))
    print(paint(bottom,accent,bold=True))
if __name__=="__main__":main()
