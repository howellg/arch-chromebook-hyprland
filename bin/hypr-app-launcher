#!/usr/bin/env bash
# Use HoloNet while Galactic Appearance is active.
selection="$HOME/.local/state/starwars-theme/selection"
if [[ -r "$selection" && -x "$HOME/.local/bin/hypr-holonet-search" ]]; then
    case "$(cat "$selection")" in
        imperial|sith|rakatan) exec "$HOME/.local/bin/hypr-holonet-search" ;;
    esac
fi
exec wofi \
    --show drun \
    --insensitive \
    --width 560 \
    --height 430 \
    --lines 9 \
    --allow-images \
    --prompt "Search applications..." \
    --style "$HOME/.config/wofi/launcher.css"
