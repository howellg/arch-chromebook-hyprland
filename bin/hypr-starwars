#!/usr/bin/env python3
"""Reversible Star Wars Hyprland themes. All art is locally generated original SVG."""
import fcntl
import json
import os
from pathlib import Path
import shutil
import signal
import socket
import subprocess as sp
import sys
import time
from galactic_styles import waybar as galactic_waybar, waybar_config as galactic_waybar_config, quick as galactic_quick, lock as galactic_lock

HOME=Path.home()
STATE=HOME/".local/state/starwars-theme"
ORIG=STATE/"catppuccin-original"
SELECTION=STATE/"selection"
WALLS=HOME/".local/share/starwars-theme/wallpapers"
AWWW=("/usr/bin/awww" if Path("/usr/bin/awww").is_file() else
      str(HOME/".local/bin/awww") if (HOME/".local/bin/awww").is_file() else shutil.which("awww"))
AWWW_DAEMON=("/usr/bin/awww-daemon" if Path("/usr/bin/awww-daemon").is_file() else
             str(HOME/".local/bin/awww-daemon") if (HOME/".local/bin/awww-daemon").is_file() else shutil.which("awww-daemon"))
FILES={
    "waybar":"~/.config/waybar/style.css",
    "waybar-config":"~/.config/waybar/config.jsonc",
    "launcher":"~/.config/wofi/launcher.css",
    "power":"~/.config/wofi/power.css",
    "cheatsheet":"~/.config/wofi/cheatsheet.css",
    "mako":"~/.config/mako/config",
    "quick":"~/.config/chromebook/quick-settings.css",
    "kitty":"~/.config/kitty/kitty.conf",
    "lock":"~/.config/hypr/hyprlock.conf",
    "paper":"~/.config/hypr/hyprpaper.conf"
}
THEMES={
    "imperial":dict(bg="#0b1019",card="#151f2b",text="#e8e9e8",muted="#abb6c2",accent="#ed6664",edge="#677383",label="IMPERIAL COMMAND"),
    "sith":dict(bg="#130c15",card="#25131e",text="#f1e6e6",muted="#bd9fa8",accent="#ed4257",edge="#91546a",label="SITH ARCHIVES"),
    "rakatan":dict(bg="#071622",card="#0d2939",text="#e5f0f2",muted="#97bbc7",accent="#64d5df",edge="#887c64",label="RAKATAN RESEARCH")
}
WORKSPACES={
    1:("imperial","imperial"),2:("sith","sith"),3:("rakatan","rakatan"),
    4:("imperial","comms"),5:("imperial","databank"),9:("imperial","bridge")
}

def path(key):return Path(os.path.expanduser(FILES[key]))
def run(*cmd,timeout=7):
    try:
        result=sp.run(cmd,text=True,capture_output=True,timeout=timeout)
        return result.returncode,result.stdout.strip(),result.stderr.strip()
    except (OSError,sp.TimeoutExpired) as e:return 127,"",str(e)
def save_originals():
    ORIG.mkdir(parents=True,exist_ok=True)
    manifest=ORIG/"manifest.json"
    presence=json.loads(manifest.read_text()) if manifest.exists() else {}
    added=False
    for key in FILES:
        if key in presence:continue
        src=path(key);presence[key]=src.is_file()
        if src.is_file():shutil.copy2(src,ORIG/key)
        added=True
    if added or not manifest.exists():manifest.write_text(json.dumps(presence,indent=2)+"\n")
def atomic_write(target,content):
    target.parent.mkdir(parents=True,exist_ok=True)
    tmp=target.with_name(target.name+".sw-theme-tmp")
    tmp.write_text(content)
    tmp.replace(target)
def base(key):
    orig=ORIG/key
    return orig.read_text() if orig.exists() else ""
def restore():
    if not (ORIG/"manifest.json").exists():raise SystemExit("No recorded original theme; nothing to restore")
    presence=json.loads((ORIG/"manifest.json").read_text())
    for key,exists in presence.items():
        dest=path(key)
        if exists:shutil.copy2(ORIG/key,dest)
        elif dest.exists():dest.unlink()
    SELECTION.write_text("catppuccin\n")
    refresh_all()
    # Restore original Hyprland active border and matching wallpaper without a compositor restart.
    apply_border(["33ccffee","00ff99ee"],"595959aa",45)
    wallpaper=base("paper")
    if wallpaper:
        import re
        m=re.search(r"^\s*path\s*=\s*(.*)$",wallpaper,re.M)
        if m and Path(m.group(1)).is_file():restore_original_wallpaper(Path(m.group(1)))
    print("Restored original Catppuccin files. Shortcuts and workspace rules untouched.")

def css_waybar_legacy(p):
    b=base("waybar")
    return b+f"""
/* STAR WARS / {p['label']} : original stylesheet stays in local backup */
window#waybar {{ color:{p['text']}; }}
tooltip {{ background:{p['card']}; border:1px solid {p['edge']}; color:{p['text']}; border-radius:5px; }}
#custom-arch,#workspaces,#window,#clock,#cpu,#memory,#network,#pulseaudio,#backlight,#battery,#tray,#custom-power,#custom-settings,#custom-power-profile {{
  background: alpha({p['bg']},0.94);
  border: 1px solid alpha({p['edge']},0.68);
  border-bottom: 2px solid alpha({p['accent']},0.58);
  border-radius: 5px;
  color:{p['text']};
}}
#custom-arch,#custom-settings,#network,#custom-power-profile {{ color:{p['accent']}; }}
#workspaces button {{ color:{p['muted']}; border-radius:3px; }}
#workspaces button.active {{ background:{p['accent']};color:{p['bg']};font-weight:bold; }}
#workspaces button:hover {{ color:{p['text']};background:alpha({p['accent']},0.30); }}
#clock {{color:{p['text']}; letter-spacing:1px;}}
#window {{color:{p['muted']};}}
#battery.warning {{color:#e5a95d;}}
#battery.critical {{color:#f05b5b;}}
#battery.charging {{color:#84d7bd;}}
#custom-power {{color:#e76565;}}
#custom-settings:hover,#custom-power:hover {{background:alpha({p['accent']},.19);}}
"""
def css_wofi(p,kind):
    # For Wofi's GTK CSS: sharp terminal corners, legible text and restrained holographic edge.
    scale=15 if kind=="power" else 14
    return f"""/* {p['label']} • Wofi faction terminal */
* {{ font-family:"JetBrainsMono Nerd Font",monospace; font-size:{scale}px; color:{p['text']}; }}
window {{ background-color:alpha({p['bg']},0.95); border:2px solid {p['accent']}; border-radius:7px; }}
#outer-box {{ margin:14px; padding:6px; background:transparent; }}
#input {{ margin-bottom:12px; padding:12px 14px; background:alpha({p['card']},.96);
 border:1px solid {p['edge']}; border-left:4px solid {p['accent']}; border-radius:4px; color:{p['text']}; box-shadow:none; }}
#inner-box,#scroll {{background:transparent;}}
#entry {{padding:10px 12px;margin:3px 0;background:transparent;border-radius:3px;}}
#entry:selected {{background:alpha({p['accent']},0.27);border-left:3px solid {p['accent']};}}
#entry:selected #text {{color:{p['text']};}}
#text {{margin-left:9px;color:{p['text']};}}
#img {{margin-right:8px;}}
"""
def css_quick_legacy(p):
    return f"""/* {p['label']} • native GTK3 command console */
window.quick-settings {{ background-color:alpha({p['bg']},0.97); color:{p['text']}; border:2px solid {p['accent']};border-radius:8px; }}
window.quick-settings label {{color:{p['text']};font-family:"JetBrainsMono Nerd Font";}}
window.quick-settings .heading {{font-size:20px;font-weight:bold;color:{p['accent']};}}
window.quick-settings .section {{color:{p['muted']};font-weight:bold;}}
window.quick-settings button {{background-image:none;background-color:alpha({p['card']},0.96); color:{p['text']};border:1px solid {p['edge']};border-radius:4px;box-shadow:none;padding:8px;}}
window.quick-settings button:hover {{background-color:alpha({p['accent']},0.24);border-color:{p['accent']};}}
window.quick-settings button:active {{background-color:{p['card']};}}
window.quick-settings trough {{min-height:8px;border-radius:4px;background:{p['card']};}}
window.quick-settings highlight {{background:{p['accent']};border-radius:4px;}}
window.quick-settings slider {{background:{p['accent']};border-radius:8px;min-width:14px;min-height:14px;}}
"""
def mako(p):
    return f"""# {p['label']} alert console
font=JetBrainsMono Nerd Font 11
background-color={p['bg']}f2
text-color={p['text']}
border-color={p['accent']}
border-size=2
border-radius=5
width=355
height=120
padding=13
margin=8
outer-margin=54,12,12,12
anchor=top-right
max-visible=3
default-timeout=6500
ignore-timeout=0
icons=1
max-icon-size=48
progress-color=over {p['accent']}
[urgency=critical]
border-color=#f05b5b
default-timeout=0
[mode=do-not-disturb]
invisible=1
"""
def lock_legacy(p):
    b=base("lock")
    mapping={"rgb(17, 17, 27)":hexrgb(p['bg']),"rgb(205, 214, 244)":hexrgb(p['text']),"rgb(137, 180, 250)":hexrgb(p['accent']),"rgb(30, 30, 46)":hexrgb(p['card'])}
    for old,new in mapping.items():b=b.replace(old,new)
    return b.replace("# Catppuccin Mocha lock screen",f"# {p['label']} lock screen")
def hexrgb(color):
    return "rgb("+", ".join(str(int(color[i:i+2],16)) for i in (1,3,5))+")"
def default_kitty_theme():
    """Keep the regular Kitty profile consistent with the selected global theme.

    Imperial hybrid retains Imperial as the default even on Sith/Rakatan sectors;
    explicit 'galactic sith' and 'galactic rakatan' remain independent.
    """
    try:
        chosen=SELECTION.read_text().strip()
    except OSError:
        chosen="imperial"
    return chosen if chosen in THEMES else "imperial"

def render(theme):
    p=THEMES[theme]
    for key,text in {
        "waybar":galactic_waybar(p,base("waybar")),
        "waybar-config":galactic_waybar_config(base("waybar-config"),HOME),
        "launcher":css_wofi(p,"launcher"),
        "power":css_wofi(p,"power"),"cheatsheet":css_wofi(p,"cheatsheet"),
        "quick":galactic_quick(p),"mako":mako(p),
        # Theme the actual 'kitty' command too, not only galactic launchers.
        # Use the global selection, not the workspace accent: the watcher can
        # change workspace without changing the default terminal identity.
        "kitty":base("kitty")+f"\n# Galactic default Kitty (reversible via Catppuccin)\ninclude galactic-{default_kitty_theme()}.conf\n",
        "lock":galactic_lock(p, WALLS/"bridge.png" if theme == "imperial" else None)}.items():atomic_write(path(key),text)
    return p
def awww_ready():
    """Start the Arch-packaged user-level wallpaper daemon if available."""
    if not (AWWW and AWWW_DAEMON):
        return False
    if run(AWWW,"query")[0] == 0:
        return True
    sp.Popen([AWWW_DAEMON,"--no-cache"],stdout=sp.DEVNULL,
             stderr=sp.DEVNULL,start_new_session=True)
    for _ in range(12):
        if run(AWWW,"query",timeout=2)[0] == 0:
            return True
        time.sleep(.15)
    return False

def hyprpaper_apply(file):
    """Fallback and Catppuccin wallpaper management using existing Hyprpaper."""
    if run("pgrep","-x","hyprpaper")[0] != 0:
        sp.Popen(["hyprpaper"],stdout=sp.DEVNULL,
                 stderr=sp.DEVNULL,start_new_session=True)
        for _ in range(12):
            if run("hyprctl","hyprpaper","listactive",timeout=2)[0] == 0:break
            time.sleep(.15)
    rc,monitors,_=run("hyprctl","monitors","-j")
    if rc:return False
    success=False
    try:
        for mon in json.loads(monitors):
            rc,output,_=run("hyprctl","hyprpaper","wallpaper",
                            f"{mon['name']},{file},contain",timeout=10)
            success|=(rc==0)
    except (ValueError,KeyError):pass
    return success

def wallpaper_apply(file):
    if not file.is_file():return
    if awww_ready():
        rc,_,err=run(AWWW,"img","--resize","fit","--transition-type","fade",
                     "--transition-duration","0.38","--transition-fps","60",str(file),
                     timeout=12)
        if rc==0:
            # Swap daemons only after the replacement image was submitted.
            if run("pgrep","-x","hyprpaper")[0] == 0:
                run("pkill","-TERM","-x","hyprpaper")
            return
        print("awww image update failed: "+err,file=sys.stderr)
    # No awww: preserve wallpapers via Hyprpaper, though its switches can flash.
    hyprpaper_apply(file)

def restore_original_wallpaper(file):
    if not file.is_file():return
    # Create the original wallpaper behind awww first to avoid revealing an
    # empty compositor background while changing back to Catppuccin.
    if hyprpaper_apply(file):
        if AWWW and run(AWWW,"query")[0] == 0:
            run(AWWW,"kill")

def refresh_all(waybar=True):
    # A full Waybar SIGUSR2 on every workspace switch briefly flashes the bar.
    # Keep it stable during transitions; reload only for explicit theme changes.
    if waybar:run("pkill","-USR2","waybar")
    run("makoctl","reload")
def workspace():
    rc,out,_=run("hyprctl","activeworkspace","-j")
    try:return int(json.loads(out).get("id",1)) if rc==0 else 1
    except (ValueError,TypeError):return 1
def apply_border(colors,inactive,angle):
    # Hyprland 0.57 Lua: the old 'hyprctl keyword' command returns 'unknown request'.
    # Lua-dispatch a function, leaving existing window rules and shortcuts untouched.
    stops=",".join(f'"rgba({color})"' for color in colors)
    expression=("function() hl.config({ general = { col = { "
        f"active_border = {{ colors = {{{stops}}}, angle = {angle} }}, "
        f'inactive_border = "rgba({inactive})"'
        " } } }) end")
    rc,out,err=run("hyprctl","dispatch",expression)
    if rc!=0 or out!="ok":print("Border update failed:",out or err,file=sys.stderr)
def update_current(force=False):
    if not SELECTION.exists():return
    chosen=SELECTION.read_text().strip()
    if chosen=="catppuccin":return
    index=workspace()
    # Imperial is the per-workspace hybrid. Selecting another faction makes
    # that faction global, with the same rollback path.
    theme,wall=WORKSPACES.get(index,("imperial","imperial")) if chosen=="imperial" else (chosen,chosen)
    p=render(theme)
    # Match the Waybar sector indicator in Imperial Hybrid.
    sector_accents = {2: "ed4257", 3: "64d5df", 4: "81b1da", 5: "d6af6a", 9: "ed6664"}
    accent = sector_accents.get(index, p["accent"][1:]) if chosen == "imperial" else p["accent"][1:]
    apply_border([accent+"ee"], "44465099", 0)
    wallpaper_apply(WALLS/(wall+".png"))
    refresh_all(waybar=force)
    (STATE/"last-workspace").write_text(f"{index} {theme} {wall}\n")
def choose(theme):
    if theme not in (*THEMES,"catppuccin"):raise SystemExit("Theme must be imperial, sith, rakatan, or catppuccin")
    save_originals()
    if theme=="catppuccin":restore();return
    if not (WALLS/"imperial.png").exists():
        print("Wallpaper assets missing; generate wallpapers first.",file=sys.stderr);raise SystemExit(2)
    SELECTION.write_text(theme+"\n")
    update_current(force=True)
    layout=("1 Imperial • 2 Sith • 3 Rakatan • 4 Comms • 5 Databank • 9 Bridge"
            if theme=="imperial" else "all workspaces: "+THEMES[theme]["label"])
    print("Active theme: "+theme+"; "+layout)
def watch():
    STATE.mkdir(parents=True,exist_ok=True)
    lock=(STATE/"watch.lock").open("w")
    try:fcntl.flock(lock,fcntl.LOCK_EX|fcntl.LOCK_NB)
    except BlockingIOError:return
    signature=os.environ.get("HYPRLAND_INSTANCE_SIGNATURE")
    runtime=os.environ.get("XDG_RUNTIME_DIR",f"/run/user/{os.getuid()}")
    if not signature:
        print("No Hyprland session found",file=sys.stderr);return
    socket_path=Path(runtime)/"hypr"/signature/".socket2.sock"
    if not socket_path.is_socket():
        print("Hyprland event socket missing: "+str(socket_path),file=sys.stderr);return
    while True:
        try:
            if SELECTION.exists() and SELECTION.read_text().strip()!="catppuccin":update_current(force=True)
            with socket.socket(socket.AF_UNIX,socket.SOCK_STREAM) as channel:
                channel.connect(str(socket_path))
                channel.settimeout(30)
                buf=""
                last=-1
                while True:
                    if SELECTION.exists() and SELECTION.read_text().strip()=="catppuccin":
                        time.sleep(.5);continue
                    try:packet=channel.recv(8192).decode(errors="replace")
                    except socket.timeout:continue
                    if not packet:break
                    buf+=packet
                    while "\n" in buf:
                        event,buf=buf.split("\n",1)
                        if event.startswith(("workspace>>","workspacev2>>","focusedmon>>","focusedmonv2>>")):
                            now=workspace()
                            if now!=last:
                                last=now
                                if SELECTION.exists() and SELECTION.read_text().strip()!="catppuccin":update_current()
        except (OSError,ValueError):
            time.sleep(3)
def menu():
    labels=["Imperial hybrid / Sith and Rakatan sectors","Sith Archives global fallback","Rakatan Research global fallback","Restore Catppuccin"]
    try:
        r=sp.run(["wofi","--dmenu","--insensitive","--prompt","Galactic Appearance","--width","550","--height","260"],input="\n".join(labels)+"\n",text=True,capture_output=True,timeout=180)
        if r.returncode==0:
            pos=r.stdout.strip()
            if pos in labels:choose(("imperial","sith","rakatan","catppuccin")[labels.index(pos)])
    except (OSError,sp.TimeoutExpired) as e:print(e,file=sys.stderr)
def main():
    STATE.mkdir(parents=True,exist_ok=True)
    action=sys.argv[1] if len(sys.argv)>1 else "status"
    if action in ("apply","set"):choose(sys.argv[2] if len(sys.argv)>2 else "imperial")
    elif action=="restore":choose("catppuccin")
    elif action=="status":
        chosen=SELECTION.read_text().strip() if SELECTION.exists() else "catppuccin"
        print("Scheme: "+chosen)
        current=STATE/"last-workspace"
        if current.exists():print("Last workspace: "+current.read_text().strip())
    elif action=="watch":watch()
    elif action=="refresh":update_current(True)
    elif action=="menu":menu()
    else:raise SystemExit("Usage: hypr-starwars [status|set imperial|set sith|set rakatan|restore|menu|refresh|watch]")
if __name__=="__main__":main()
