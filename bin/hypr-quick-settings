#!/usr/bin/env python3
"""Star Wars tactical settings console, preserving existing Chromebook controls."""
import subprocess
import sys
from pathlib import Path
import gi
gi.require_version("Gtk", "3.0")
gi.require_version("Gdk", "3.0")
from gi.repository import Gtk, Gdk, GLib

HOME = Path.home()
CSS = HOME / ".config/chromebook/quick-settings.css"

def cmd(*args):
    try:
        return subprocess.run(args, capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""

def run(*args):
    try:
        subprocess.Popen(args, start_new_session=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError:
        pass

class Settings(Gtk.Window):
    def __init__(self):
        super().__init__(title="Galactic Command · Tactical Console")
        self.set_default_size(470, 700)
        self.set_resizable(True)
        self.set_border_width(16)
        self.get_style_context().add_class("quick-settings")
        self.connect("key-press-event", lambda _w, e: self.close() if e.keyval == Gdk.KEY_Escape else False)
        self.connect("destroy", Gtk.main_quit)
        self.mute_changes = True
        main = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        viewport = Gtk.ScrolledWindow()
        viewport.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        self.add(viewport)
        viewport.add_with_viewport(main)
        title = Gtk.Label(label="󰀻  TACTICAL COMMAND CENTER")
        title.set_xalign(0)
        title.get_style_context().add_class("heading")
        main.pack_start(title, False, False, 0)
        self.faction = Gtk.Label(label="IMPERIAL COMMAND  /  CONNECTED SYSTEMS")
        self.faction.set_xalign(0)
        self.faction.get_style_context().add_class("subtitle")
        main.pack_start(self.faction,False,False,0)
        grid = Gtk.Grid(column_spacing=10, row_spacing=10)
        main.pack_start(grid, False, False, 0)
        self.wifi = Gtk.Button()
        self.bt = Gtk.Button()
        self.night = Gtk.Button()
        self.profile = Gtk.Button()
        for i, btn in enumerate((self.wifi, self.bt, self.night, self.profile)):
            btn.get_style_context().add_class("toggle")
            btn.set_size_request(175, 60)
            grid.attach(btn, i % 2, i // 2, 1, 1)
        self.wifi.connect("clicked", self.toggle_wifi)
        self.bt.connect("clicked", self.toggle_bt)
        self.night.connect("clicked", self.toggle_night)
        self.profile.connect("clicked", self.cycle_profile)
        self.status_title = Gtk.Label(label="TACTICAL OVERVIEW  /  SYSTEM TELEMETRY")
        self.status_title.set_xalign(0)
        self.status_title.get_style_context().add_class("section")
        main.pack_start(self.status_title,False,False,0)
        status_grid=Gtk.Grid(column_spacing=7,row_spacing=7)
        status_grid.set_column_homogeneous(True)
        self.status_tiles={}
        for i,key in enumerate(("network","tailscale","syncthing","battery")):
            cell=Gtk.Label(label="SCANNING...")
            cell.set_xalign(0)
            cell.set_line_wrap(True)
            cell.get_style_context().add_class("status-card")
            cell.set_size_request(190,48)
            if key == "battery":
                battery_card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
                battery_card.get_style_context().add_class("status-card")
                cell.get_style_context().remove_class("status-card")
                cell.set_size_request(176, 24)
                self.battery_meter = Gtk.LevelBar.new_for_interval(0, 10)
                self.battery_meter.set_mode(Gtk.LevelBarMode.DISCRETE)
                battery_card.pack_start(cell, False, False, 0)
                battery_card.pack_start(self.battery_meter, False, False, 0)
                status_grid.attach(battery_card, i % 2, i // 2, 1, 1)
            else:
                status_grid.attach(cell, i % 2, i // 2, 1, 1)
            self.status_tiles[key]=cell
        main.pack_start(status_grid,False,True,0)
        self.volume = self.slider(main, "󰕾  Volume", 100)
        self.brightness = self.slider(main, "󰃠  Brightness", 100)
        info = Gtk.Label(label="Actions")
        info.get_style_context().add_class("section")
        info.set_xalign(0)
        main.pack_start(info, False, False, 0)
        actions = Gtk.Grid(column_spacing=8, row_spacing=8)
        main.pack_start(actions, False, False, 0)
        choices = [
            ("Networks", "nm-connection-editor"),
            ("Devices", str(HOME / ".local/bin/hypr-devices")),
            ("Notifications", str(HOME / ".local/bin/hypr-notifications")),
            ("Wallpaper", str(HOME / ".local/bin/hypr-wallpaper-picker")),
            ("Windows", str(HOME / ".local/bin/hypr-overview-grid")),
            ("App Layouts", str(HOME / ".local/bin/hypr-layouts")),
            ("Displays", str(HOME / ".local/bin/hypr-displays")),
            ("Maintenance", str(HOME / ".local/bin/hypr-maintenance")),
            ("Classroom", str(HOME / ".local/bin/hypr-classroom-center")),
            ("Galactic Theme", str(HOME / ".local/bin/hypr-starwars-menu")),
            ("HoloNet Console", str(HOME / ".local/bin/hypr-holonet-launcher")),
            ("Sith Terminal", str(HOME / ".local/bin/hypr-galactic-sith")),
            ("Rakatan Terminal", str(HOME / ".local/bin/hypr-galactic-rakatan")),
            ("OCR Text", str(HOME / ".local/bin/hypr-classroom-ocr")),
            ("Backups", str(HOME / ".local/bin/hypr-classroom-backup")),
            ("First-Run", str(HOME / ".local/bin/hypr-first-run")),
            ("Power", str(HOME / ".local/bin/hypr-power-menu")),
            ("Close", None),
        ]
        for i, (label, command) in enumerate(choices):
            button = Gtk.Button(label=label)
            button.get_style_context().add_class("action")
            button.connect("clicked", self.launch, command)
            actions.attach(button, i % 3, i // 3, 1, 1)
        self.mode_label = Gtk.Label(label="Desktop Modes")
        self.mode_label.set_xalign(0)
        self.mode_label.get_style_context().add_class("section")
        main.pack_start(self.mode_label, False, False, 0)
        modes = Gtk.Box(spacing=8)
        main.pack_start(modes, False, False, 0)
        for name in ("normal", "class", "presentation"):
            btn = Gtk.Button(label=name.title())
            btn.get_style_context().add_class("action")
            btn.connect("clicked", self.set_mode, name)
            modes.pack_start(btn, True, True, 0)
        self.refresh()
        self.show_all()
        GLib.timeout_add_seconds(10, self.refresh)

    def slider(self, parent, label, max_value):
        text = Gtk.Label(label=label)
        text.set_xalign(0)
        parent.pack_start(text, False, False, 0)
        s = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, max_value, 1)
        s.set_draw_value(True)
        for value in range(0, max_value + 1, 10):
            s.add_mark(value, Gtk.PositionType.BOTTOM, None)
        s.set_digits(0)
        s.set_size_request(300, 35)
        s.get_style_context().add_class("level")
        parent.pack_start(s, False, False, 0)
        s.connect("value-changed", self.set_level, label)
        return s

    def set_level(self, scale, label):
        if self.mute_changes:
            return
        value = round(scale.get_value())
        if "Volume" in label:
            run("wpctl", "set-volume", "@DEFAULT_AUDIO_SINK@", str(value / 100))
        else:
            run("brightnessctl", "-c", "backlight", "set", f"{value}%")

    def launch(self, _button, command):
        if command:
            run(command)
        self.close()

    def refresh(self):
        self.mute_changes = True
        active_mode = cmd(str(HOME / ".local/bin/hypr-desktop-mode"), "status") or "normal"
        self.mode_label.set_text(f"Desktop Modes · {active_mode.title()}")
        try:
            ws=(HOME/".local/state/starwars-theme/last-workspace").read_text().split()
            sector=ws[0] if ws else "01"
            theme=ws[1].upper() if len(ws)>1 else "IMPERIAL"
        except OSError:
            sector="01";theme="IMPERIAL"
        self.faction.set_text(f"{theme} COMMAND  /  SECTOR {sector}  /  SYSTEMS ONLINE")
        self.status_tiles["tailscale"].set_text("TAILSCALE  /  "+(cmd("systemctl","is-active","tailscaled") or "UNKNOWN").upper())
        self.status_tiles["syncthing"].set_text("SYNCTHING  /  "+(cmd("systemctl","--user","is-active","syncthing") or "UNKNOWN").upper())
        try:
            capacity = int(Path("/sys/class/power_supply/BAT0/capacity").read_text())
        except (OSError, ValueError):
            capacity = None
        self.status_tiles["battery"].set_text("BATTERY  /  " + ("N/A" if capacity is None else f"{capacity}%"))
        self.battery_meter.set_value(0 if capacity is None else capacity / 10)
        wifi = cmd("nmcli", "radio", "wifi").lower()
        self.status_tiles["network"].set_text("NETWORK  /  "+("CONNECTED" if ":connected:" in cmd("nmcli","-t","-f","DEVICE,STATE,CONNECTION","device","status") else ("READY" if wifi=="enabled" else "OFFLINE")))
        self.wifi.set_label(f"󰤨  Wi-Fi\n{'Enabled' if wifi == 'enabled' else 'Disabled'}")
        bluetooth = cmd("bluetoothctl", "show")
        bt_on = "\tPowered: yes" in bluetooth or "\tPowered: yes" in bluetooth
        self.bt.set_label(f"  Bluetooth\n{'On' if bt_on else 'Off'}")
        profile = cmd("powerprofilesctl", "get") or "Unavailable"
        state = HOME / ".config/chromebook/power-mode"
        mode = state.read_text().strip() if state.is_file() else "manual"
        self.profile.set_label(f"󰾆  Power\n{profile} ({mode})")
        sunset = cmd("hyprctl", "hyprsunset", "profile")
        is_warm = "Identity: false" in sunset
        self.night.set_label(f"󰖔  Night Light\n{'Warm' if is_warm else 'Scheduled'}")
        audio = cmd("wpctl", "get-volume", "@DEFAULT_AUDIO_SINK@")
        try:
            self.volume.set_value(round(float(audio.split()[1]) * 100))
        except (IndexError, ValueError):
            pass
        bright = cmd("brightnessctl", "-c", "backlight", "-m").split(",")
        if len(bright) > 3:
            try:
                self.brightness.set_value(int(bright[3].strip("%")))
            except ValueError:
                pass
        self.mute_changes = False
        return True

    def toggle_wifi(self, _button):
        state = cmd("nmcli", "radio", "wifi").lower()
        run("nmcli", "radio", "wifi", "off" if state == "enabled" else "on")
        GLib.timeout_add(600, self.refresh)

    def toggle_bt(self, _button):
        state = cmd("bluetoothctl", "show")
        run("bluetoothctl", "power", "off" if "Powered: yes" in state else "on")
        GLib.timeout_add(1000, self.refresh)

    def toggle_night(self, _button):
        state = cmd("hyprctl", "hyprsunset", "profile")
        if "Identity: false" in state:
            run("hyprctl", "hyprsunset", "reset")
        else:
            run("hyprctl", "hyprsunset", "temperature", "4800")
        GLib.timeout_add(500, self.refresh)

    def cycle_profile(self, _button):
        state = HOME / ".config/chromebook/power-mode"
        mode = state.read_text().strip() if state.is_file() else "auto"
        choices = ("auto", "power-saver", "balanced", "performance")
        mode = choices[(choices.index(mode) + 1) % len(choices)] if mode in choices else "auto"
        run(str(HOME / ".local/bin/hypr-power-profile"), mode)
        GLib.timeout_add(900, self.refresh)

    def set_mode(self, _button, mode):
        run(str(HOME / ".local/bin/hypr-desktop-mode"), mode)
        self.close()

    def close(self):
        self.destroy()

if __name__ == "__main__":
    provider = Gtk.CssProvider()
    try:
        provider.load_from_path(str(CSS))
        Gtk.StyleContext.add_provider_for_screen(
            Gdk.Screen.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    except Exception:
        pass
    window = Settings()
    Gtk.main()
