#!/usr/bin/env python3
"""Event-driven Waybar Galactic sector indicator: no bar restarts or polling loop."""
import json
import os
from pathlib import Path
import socket
import subprocess
import sys

HOME=Path.home()
SELECTION=HOME/".local/state/starwars-theme/selection"
SECTORS={
 1:("01","INTEL","imperial","Imperial Intelligence / Firefox"),
 2:("02","SITH","sith","Sith Archives / Kitty"),
 3:("03","RAKATAN","rakatan","Rakatan Research / VS Code"),
 4:("04","COMMS","comms","Fleet Communications / Discord"),
 5:("05","DATA","databank","Imperial Databanks / MySQL"),
 9:("09","BRIDGE","bridge","Command Bridge / Desktop Commander")
}
def run(args):
    try:
        result=subprocess.run(args,text=True,capture_output=True,timeout=3)
        return result.stdout.strip() if result.returncode==0 else ""
    except (OSError,subprocess.TimeoutExpired):return ""
def status():
    try:
        ws=json.loads(run(["hyprctl","activeworkspace","-j"]) or "{}").get("id",1)
    except ValueError:ws=1
    try:ws=int(ws)
    except (TypeError,ValueError):ws=1
    try:chosen=SELECTION.read_text().strip()
    except OSError:chosen="catppuccin"
    number,short,accent,label=SECTORS.get(ws,(f"{ws:02d}","SECTOR","imperial","Outer Rim Sector"))
    if chosen=="sith":
        accent="sith";label="Sith Archives / "+label
    elif chosen=="rakatan":
        accent="rakatan";label="Rakatan Research / "+label
    elif chosen=="catppuccin":
        accent="imperial"
    title=""
    try:title=json.loads(run(["hyprctl","activewindow","-j"]) or "{}").get("title","")
    except ValueError:pass
    tip=f"SECTOR {number}  /  {label}"
    if title:tip+="\nACTIVE WINDOW: "+title[:90]
    return {"text":f"◆ {number} / {short}","tooltip":tip,"class":accent}

def follow():
    sig=os.environ.get("HYPRLAND_INSTANCE_SIGNATURE","")
    runtime=os.environ.get("XDG_RUNTIME_DIR",f"/run/user/{os.getuid()}")
    address=Path(runtime)/"hypr"/sig/".socket2.sock"
    previous=""
    while True:
        try:
            with socket.socket(socket.AF_UNIX,socket.SOCK_STREAM) as client:
                client.connect(str(address))
                client.settimeout(1.2)
                buffer=""
                while True:
                    current=json.dumps(status(),ensure_ascii=False)
                    if current!=previous:
                        print(current,flush=True)
                        previous=current
                    try:chunk=client.recv(4096).decode(errors="replace")
                    except socket.timeout:continue
                    if not chunk:break
                    buffer+=chunk
                    while "\n" in buffer:
                        event,buffer=buffer.split("\n",1)
                        # Most events are irrelevant: only emit on focused desktop/window change.
                        if event.startswith(("workspace>>","workspacev2>>","focusedmon>>","focusedmonv2>>","activewindow>>","activewindowv2>>")):
                            current=json.dumps(status(),ensure_ascii=False)
                            if current!=previous:
                                print(current,flush=True)
                                previous=current
        except (OSError,KeyboardInterrupt):
            if sys.stdout.closed:break
            import time
            time.sleep(2)

if __name__=="__main__":
    if len(sys.argv)>1 and sys.argv[1]=="--follow":follow()
    else:print(json.dumps(status(),ensure_ascii=False))
