#!/usr/bin/env python3
"""Live CPU, memory, temperature, and battery readings for Command Bridge."""
from collections import deque
from dataclasses import dataclass
import json
import os
from pathlib import Path
import sys
import subprocess
from time import monotonic

HISTORY_SECONDS = 60
PROCESS_LIMIT = 15
CLOCK_TICKS = os.sysconf("SC_CLK_TCK")
PAGE_BYTES = os.sysconf("SC_PAGE_SIZE")


@dataclass(frozen=True)
class Reading:
    label: str
    value: str
    detail: str
    fraction: float | None = None
    degrees: float | None = None


def read(path):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return ""


def cpu_counters():
    fields = read("/proc/stat").splitlines()
    if fields:
        try:
            values = list(map(int, fields[0].split()[1:9]))
            return sum(values), values[3] + values[4]
        except (IndexError, ValueError):
            pass
    return None


def cpu_reading(before, after):
    if before and after:
        total = after[0] - before[0]
        idle = after[1] - before[1]
        if total > 0 and 0 <= idle <= total:
            fraction = (total - idle) / total
            return Reading("CPU", f"{fraction:.0%}", "Overall processor usage", fraction)
    return Reading("CPU", "—", "Waiting for a sample" if after else "Usage unavailable")


def memory_reading():
    memory = {}
    for line in read("/proc/meminfo").splitlines():
        key, _, value = line.partition(":")
        if key in {"MemTotal", "MemAvailable"}:
            try:
                memory[key] = int(value.split()[0])
            except (IndexError, ValueError):
                continue
    total = memory.get("MemTotal", 0)
    available = memory.get("MemAvailable")
    if total > 0 and available is not None and 0 <= available <= total:
        used = total - available
        gib = 1024 ** 2
        return Reading("RAM", f"{used / gib:.1f} / {total / gib:.1f} GiB",
                       f"{available / gib:.1f} GiB available", used / total)
    return Reading("RAM", "—", "Memory readings unavailable")


def temperature_reading():
    for device in sorted(Path("/sys/class/hwmon").glob("hwmon*")):
        driver = read(device / "name")
        if driver not in {"coretemp", "k10temp"}:
            continue
        for sensor in sorted(device.glob("temp*_label")):
            label = read(sensor)
            if not label.startswith("Package id ") and label not in {"Tdie", "Tctl"}:
                continue
            try:
                degrees = int(read(sensor.with_name(sensor.name.replace("_label", "_input")))) / 1000
            except ValueError:
                continue
            return Reading("CPU TEMPERATURE", f"{degrees:.0f} °C", label, degrees=degrees)
    return Reading("CPU TEMPERATURE", "—", "CPU sensor unavailable")


def battery_reading():
    for device in sorted(Path("/sys/class/power_supply").glob("BAT*")):
        try:
            capacity = int(read(device / "capacity"))
        except ValueError:
            continue
        if 0 <= capacity <= 100:
            state = read(device / "status") or "Charge state unavailable"
            return Reading("BATTERY", f"{capacity}%", state, capacity / 100)
    return Reading("BATTERY", "—", "Battery readings unavailable")


def readings(before, after):
    return (cpu_reading(before, after), memory_reading(), temperature_reading(), battery_reading())


def process_sample():
    processes = {}
    for directory in Path("/proc").iterdir():
        if not directory.name.isdecimal():
            continue
        stat = read(directory / "stat")
        prefix, separator, suffix = stat.rpartition(")")
        if not separator:
            continue
        fields = suffix.split()
        try:
            parent = int(fields[1])
            ticks = int(fields[11]) + int(fields[12])
            started = int(fields[19])
            resident = max(0, int(fields[21])) * PAGE_BYTES
        except (IndexError, ValueError):
            continue
        name = prefix.partition("(")[2].replace("\n", " ").replace("\t", " ")
        processes[(int(directory.name), started)] = (name, ticks, resident, parent)
    return processes


def process_usage(previous, current, elapsed):
    rows = {}
    for identity, (name, ticks, resident, _) in current.items():
        old = previous.get(identity)
        cpu = None
        if old is not None and elapsed > 0 and ticks >= old[1]:
            cpu = 100 * (ticks - old[1]) / (CLOCK_TICKS * elapsed)
        rows[identity[0]] = (name, identity[0], cpu, resident)
    return rows


def usage_key(row, sort_by):
    _, _, cpu, resident = row
    cpu = -1 if cpu is None else cpu
    return (resident, cpu) if sort_by == "ram" else (cpu, resident)


def window_apps():
    try:
        windows = json.loads(subprocess.check_output(
            ["hyprctl", "clients", "-j"], stderr=subprocess.DEVNULL, timeout=0.5))
    except (OSError, ValueError, subprocess.SubprocessError):
        return {}
    return {window["pid"]: window.get("initialClass") or window.get("class")
            for window in windows if window.get("mapped") and window.get("pid", 0) > 0
            and (window.get("initialClass") or window.get("class"))}


def grouped_apps(apps, sample, rows):
    parents = {pid: data[3] for (pid, _), data in sample.items()}
    groups = {}
    for pid, row in rows.items():
        ancestor = pid
        visited = set()
        while ancestor in parents and ancestor not in visited:
            if ancestor in apps:
                name = apps[ancestor]
                groups.setdefault(name.casefold(), (name, []))[1].append(row)
                break
            visited.add(ancestor)
            ancestor = parents[ancestor]

    result = []
    for name, members in groups.values():
        sampled_cpu = [row[2] for row in members if row[2] is not None]
        summary = (name, 0, sum(sampled_cpu) if sampled_cpu else None,
                   sum(row[3] for row in members))
        result.append((summary, members))
    return result


def draw_trend(area, cr, history, ceiling):
    width = area.get_allocated_width() - 2
    height = area.get_allocated_height() - 2
    cr.set_source_rgb(.20, .23, .30)
    cr.set_line_width(1)
    for y in (1, 1 + height / 2, 1 + height):
        cr.move_to(1, y)
        cr.line_to(1 + width, y)
    cr.stroke()
    if not history:
        return False

    right = history[-1][0]
    cr.set_source_rgb(.93, .47, .46)
    cr.set_line_width(1.8)
    previous = None
    for timestamp, value in history:
        if value is None:
            previous = None
            continue
        x = 1 + width * (1 - (right - timestamp) / HISTORY_SECONDS)
        y = 1 + height * (1 - min(1, max(0, value / ceiling)))
        if previous is not None and timestamp - previous[0] <= 2.5:
            cr.move_to(*previous[1:])
            cr.line_to(x, y)
            cr.stroke()
        cr.arc(x, y, 1.25, 0, 6.283185)
        cr.fill()
        previous = timestamp, x, y
    return False


def launch():
    import gi
    gi.require_foreign("cairo")
    from galactic_panel import GLib, Gtk, heading, panel

    window = panel("Command Bridge System Monitor", 620, 390)
    root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    window.add(root)
    root.pack_start(heading("\ue906   COMMAND BRIDGE / SYSTEM MONITOR"), False, False, 0)
    pages = Gtk.Notebook()
    root.pack_start(pages, True, True, 0)
    grid = Gtk.Grid(column_spacing=10, row_spacing=10, column_homogeneous=True, margin_top=9)
    pages.append_page(grid, Gtk.Label(label="Overview"))
    widgets = []
    inspect_buttons = {}

    cards = (("CPU", 1, "0–100%"), ("RAM", 1, "0–100%"),
             ("CPU TEMPERATURE", 110, "0–110 °C"), ("BATTERY", None, ""))
    for index, (label, ceiling, units) in enumerate(cards):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        card.get_style_context().add_class("destination")
        grid.attach(card, index % 2, index // 2, 1, 1)
        card.pack_start(Gtk.Label(label=label, xalign=0), False, False, 0)
        value = Gtk.Label(xalign=0)
        value.get_style_context().add_class("monitor-value")
        card.pack_start(value, False, False, 0)
        detail = Gtk.Label(xalign=0, wrap=True)
        card.pack_start(detail, False, False, 0)
        meter = Gtk.LevelBar.new_for_interval(0, 10)
        meter.set_mode(Gtk.LevelBarMode.DISCRETE)
        meter.set_no_show_all(True)
        card.pack_end(meter, False, False, 0)
        history = deque()
        trend = None
        if ceiling is not None:
            trend = Gtk.DrawingArea()
            trend.set_size_request(-1, 58)
            trend.connect("draw", draw_trend, history, ceiling)
            card.pack_start(trend, True, True, 0)
            legend = Gtk.Label(label=f"Last 60 s  ·  {units}", xalign=0)
            card.pack_start(legend, False, False, 0)
        if label in ("CPU", "RAM"):
            inspect = Gtk.Button(label=f"Inspect {label} apps")
            card.pack_start(inspect, False, False, 0)
            inspect_buttons[label.lower()] = inspect
        widgets.append((value, detail, meter, trend, history))

    process_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=9)
    pages.append_page(process_page, Gtk.Label(label="Top Processes"))
    toolbar = Gtk.Box(spacing=8)
    process_page.pack_start(toolbar, False, False, 0)
    toolbar.pack_start(Gtk.Label(label="Sort by"), False, False, 0)
    sort = Gtk.ComboBoxText()
    sort.append("cpu", "CPU")
    sort.append("ram", "RAM")
    sort.set_active_id("cpu")
    toolbar.pack_start(sort, False, False, 0)

    app_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=9)
    pages.append_page(app_page, Gtk.Label(label="Top Apps"))
    app_toolbar = Gtk.Box(spacing=8)
    app_page.pack_start(app_toolbar, False, False, 0)
    search = Gtk.SearchEntry()
    search.set_placeholder_text("Find an app")
    app_toolbar.pack_start(search, True, True, 0)
    app_sort = Gtk.ComboBoxText()
    app_sort.append("cpu", "Sort by CPU")
    app_sort.append("ram", "Sort by RAM")
    app_sort.set_active_id("cpu")
    app_toolbar.pack_start(app_sort, False, False, 0)
    freeze = Gtk.ToggleButton(label="Freeze list")
    app_toolbar.pack_start(freeze, False, False, 0)

    app_store = Gtk.TreeStore(str, str, str, str)
    app_table = Gtk.TreeView(model=app_store)
    for index, title in enumerate(("App / process", "Processes / PID", "CPU", "RAM · RSS")):
        renderer = Gtk.CellRendererText()
        column = Gtk.TreeViewColumn(title, renderer, text=index)
        if index == 0:
            column.set_expand(True)
        app_table.append_column(column)
    app_scroll = Gtk.ScrolledWindow(min_content_height=250)
    app_scroll.add(app_table)
    app_page.pack_start(app_scroll, True, True, 0)
    app_status = Gtk.Label(xalign=0, wrap=True)
    app_page.pack_start(app_status, False, False, 0)

    store = Gtk.ListStore(str, int, str, str)
    table = Gtk.TreeView(model=store)
    for index, title in enumerate(("Process", "PID", "CPU", "RAM · RSS")):
        renderer = Gtk.CellRendererText()
        if index:
            renderer.set_property("xalign", 1)
        column = Gtk.TreeViewColumn(title, renderer, text=index)
        if index == 0:
            column.set_expand(True)
        table.append_column(column)
    scroll = Gtk.ScrolledWindow(min_content_height=250)
    scroll.add(table)
    process_page.pack_start(scroll, True, True, 0)
    detail = Gtk.Label(label="CPU is relative to one logical core. RSS includes shared memory.",
                       xalign=0, wrap=True)
    process_page.pack_start(detail, False, False, 0)

    before = None
    previous_processes = {}
    previous_time = None
    process_rows = {}
    app_groups = []
    expanded_apps = set()
    rebuilding = False

    def display_usage(cpu, resident):
        return ("—" if cpu is None else f"{cpu:.1f}%", f"{resident / 1024**2:.1f} MiB")

    def render_processes(*_):
        store.clear()
        ranked = sorted(process_rows.values(),
                        key=lambda row: usage_key(row, sort.get_active_id()), reverse=True)
        for name, pid, cpu, resident in ranked[:PROCESS_LIMIT]:
            store.append((name, pid, *display_usage(cpu, resident)))

    def render_apps(*_):
        nonlocal rebuilding
        query = search.get_text().strip().casefold()
        sort_by = app_sort.get_active_id()
        ranked = sorted(app_groups, key=lambda group: usage_key(group[0], sort_by), reverse=True)
        adjustment = app_scroll.get_vadjustment()
        scroll_position = adjustment.get_value()
        rebuilding = True
        app_store.clear()
        count = 0
        for (name, _, cpu, resident), members in ranked:
            if query not in name.casefold():
                continue
            count += 1
            parent = app_store.append(None, (name, str(len(members)), *display_usage(cpu, resident)))
            for member, pid, child_cpu, child_ram in sorted(
                    members, key=lambda row: usage_key(row, sort_by), reverse=True):
                app_store.append(parent, (member, str(pid), *display_usage(child_cpu, child_ram)))
            if name in expanded_apps:
                app_table.expand_row(app_store.get_path(parent), False)
        rebuilding = False
        adjustment.set_value(scroll_position)
        if count:
            app_status.set_text(("Frozen · " if freeze.get_active() else "") +
                                "Windowed apps and their child processes. Summed RSS can count shared memory twice.")
        else:
            app_status.set_text("No matching apps" if query else "No windowed apps detected")

    def remember_expansion(_, row, __, expanded):
        if not rebuilding:
            name = app_store[row][0]
            if expanded:
                expanded_apps.add(name)
            else:
                expanded_apps.discard(name)

    def refresh_processes(index):
        nonlocal previous_processes, previous_time, process_rows, app_groups
        if index == 2 and freeze.get_active() and app_groups:
            return
        apps = window_apps() if index == 2 else {}
        current = process_sample()
        now = monotonic()
        elapsed = now - previous_time if previous_time is not None else 0
        process_rows = process_usage(previous_processes, current, elapsed)
        previous_processes, previous_time = current, now
        if index == 2:
            app_groups = grouped_apps(apps, current, process_rows)
            render_apps()
        else:
            render_processes()

    def switch_page(_, __, index):
        nonlocal previous_time, previous_processes
        previous_processes, previous_time = {}, None
        if index:
            refresh_processes(index)

    def toggle_freeze(button):
        nonlocal previous_processes, previous_time
        if not button.get_active():
            previous_processes, previous_time = {}, None
            refresh_processes(2)
        else:
            render_apps()

    def inspect_apps(_, metric):
        freeze.set_active(False)
        search.set_text("")
        app_sort.set_active_id(metric)
        pages.set_current_page(2)

    for metric, inspect in inspect_buttons.items():
        inspect.connect("clicked", inspect_apps, metric)
    sort.connect("changed", render_processes)
    search.connect("search-changed", render_apps)
    app_sort.connect("changed", render_apps)
    freeze.connect("toggled", toggle_freeze)
    app_table.connect("row-expanded", remember_expansion, True)
    app_table.connect("row-collapsed", remember_expansion, False)
    pages.connect("switch-page", switch_page)

    def refresh():
        nonlocal before
        after = cpu_counters()
        now = monotonic()
        for (value, detail, meter, trend, history), reading in zip(widgets, readings(before, after)):
            value.set_text(reading.value)
            detail.set_text(reading.detail)
            meter.set_visible(reading.fraction is not None)
            if reading.fraction is not None:
                meter.set_value(round(reading.fraction * 10))
            if trend is not None:
                sample = reading.degrees if reading.label == "CPU TEMPERATURE" else reading.fraction
                history.append((now, sample))
                while history[0][0] < now - HISTORY_SECONDS:
                    history.popleft()
                trend.queue_draw()
        before = after
        index = pages.get_current_page()
        if index > 0:
            refresh_processes(index)
        return GLib.SOURCE_CONTINUE

    window.show_all()
    refresh()
    GLib.timeout_add_seconds(1, refresh)
    Gtk.main()


if __name__ == "__main__":
    if sys.argv[1:] == ["--status"]:
        from dataclasses import asdict
        from time import sleep
        before = cpu_counters()
        sleep(0.25)
        print(json.dumps([asdict(item) for item in readings(before, cpu_counters())]))
    else:
        launch()
