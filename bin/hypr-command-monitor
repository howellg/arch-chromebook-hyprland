#!/usr/bin/env python3
"""Live CPU, memory, temperature, and battery readings for Command Bridge."""
from collections import deque
from dataclasses import dataclass
import json
import os
from pathlib import Path
import sys
from time import monotonic

HISTORY_SECONDS = 60
PROCESS_LIMIT = 15
CLOCK_TICKS = os.sysconf("SC_CLK_TCK")
PAGE_BYTES = os.sysconf("SC_PAGE_SIZE")


@dataclass(frozen=True)
class Reading:
    label: str
    value: str
    detail: str
    fraction: float | None = None
    degrees: float | None = None


def read(path):
    try:
        return Path(path).read_text().strip()
    except OSError:
        return ""


def cpu_counters():
    fields = read("/proc/stat").splitlines()
    if fields:
        try:
            values = list(map(int, fields[0].split()[1:9]))
            return sum(values), values[3] + values[4]
        except (IndexError, ValueError):
            pass
    return None


def cpu_reading(before, after):
    if before and after:
        total = after[0] - before[0]
        idle = after[1] - before[1]
        if total > 0 and 0 <= idle <= total:
            fraction = (total - idle) / total
            return Reading("CPU", f"{fraction:.0%}", "Overall processor usage", fraction)
    return Reading("CPU", "—", "Waiting for a sample" if after else "Usage unavailable")


def memory_reading():
    memory = {}
    for line in read("/proc/meminfo").splitlines():
        key, _, value = line.partition(":")
        if key in {"MemTotal", "MemAvailable"}:
            try:
                memory[key] = int(value.split()[0])
            except (IndexError, ValueError):
                continue
    total = memory.get("MemTotal", 0)
    available = memory.get("MemAvailable")
    if total > 0 and available is not None and 0 <= available <= total:
        used = total - available
        gib = 1024 ** 2
        return Reading("RAM", f"{used / gib:.1f} / {total / gib:.1f} GiB",
                       f"{available / gib:.1f} GiB available", used / total)
    return Reading("RAM", "—", "Memory readings unavailable")


def temperature_reading():
    for device in sorted(Path("/sys/class/hwmon").glob("hwmon*")):
        driver = read(device / "name")
        if driver not in {"coretemp", "k10temp"}:
            continue
        for sensor in sorted(device.glob("temp*_label")):
            label = read(sensor)
            if not label.startswith("Package id ") and label not in {"Tdie", "Tctl"}:
                continue
            try:
                degrees = int(read(sensor.with_name(sensor.name.replace("_label", "_input")))) / 1000
            except ValueError:
                continue
            return Reading("CPU TEMPERATURE", f"{degrees:.0f} °C", label, degrees=degrees)
    return Reading("CPU TEMPERATURE", "—", "CPU sensor unavailable")


def battery_reading():
    for device in sorted(Path("/sys/class/power_supply").glob("BAT*")):
        try:
            capacity = int(read(device / "capacity"))
        except ValueError:
            continue
        if 0 <= capacity <= 100:
            state = read(device / "status") or "Charge state unavailable"
            return Reading("BATTERY", f"{capacity}%", state, capacity / 100)
    return Reading("BATTERY", "—", "Battery readings unavailable")


def readings(before, after):
    return (cpu_reading(before, after), memory_reading(), temperature_reading(), battery_reading())


def process_sample():
    processes = {}
    for directory in Path("/proc").iterdir():
        if not directory.name.isdecimal():
            continue
        stat = read(directory / "stat")
        prefix, separator, suffix = stat.rpartition(")")
        if not separator:
            continue
        fields = suffix.split()
        try:
            ticks = int(fields[11]) + int(fields[12])
            started = int(fields[19])
            resident = max(0, int(fields[21])) * PAGE_BYTES
        except (IndexError, ValueError):
            continue
        name = prefix.partition("(")[2].replace("\n", " ").replace("\t", " ")
        processes[(int(directory.name), started)] = (name, ticks, resident)
    return processes


def rank_processes(previous, current, elapsed, sort_by):
    rows = []
    for identity, (name, ticks, resident) in current.items():
        old = previous.get(identity)
        cpu = None
        if old is not None and elapsed > 0 and ticks >= old[1]:
            cpu = 100 * (ticks - old[1]) / (CLOCK_TICKS * elapsed)
        rows.append((name, identity[0], cpu, resident))
    def sort_key(row):
        _, pid, cpu, resident = row
        cpu = cpu if cpu is not None else -1
        return (-resident, -cpu, pid) if sort_by == "ram" else (-cpu, -resident, pid)
    return sorted(rows, key=sort_key)[:PROCESS_LIMIT]


def draw_trend(area, cr, history, ceiling):
    width = area.get_allocated_width() - 2
    height = area.get_allocated_height() - 2
    cr.set_source_rgb(.20, .23, .30)
    cr.set_line_width(1)
    for y in (1, 1 + height / 2, 1 + height):
        cr.move_to(1, y)
        cr.line_to(1 + width, y)
    cr.stroke()
    if not history:
        return False

    right = history[-1][0]
    cr.set_source_rgb(.93, .47, .46)
    cr.set_line_width(1.8)
    previous = None
    for timestamp, value in history:
        if value is None:
            previous = None
            continue
        x = 1 + width * (1 - (right - timestamp) / HISTORY_SECONDS)
        y = 1 + height * (1 - min(1, max(0, value / ceiling)))
        if previous is not None and timestamp - previous[0] <= 2.5:
            cr.move_to(*previous[1:])
            cr.line_to(x, y)
            cr.stroke()
        cr.arc(x, y, 1.25, 0, 6.283185)
        cr.fill()
        previous = timestamp, x, y
    return False


def launch():
    import gi
    gi.require_foreign("cairo")
    from galactic_panel import GLib, Gtk, heading, panel

    window = panel("Command Bridge System Monitor", 620, 390)
    root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
    window.add(root)
    root.pack_start(heading("\ue906   COMMAND BRIDGE / SYSTEM MONITOR"), False, False, 0)
    pages = Gtk.Notebook()
    root.pack_start(pages, True, True, 0)
    grid = Gtk.Grid(column_spacing=10, row_spacing=10, column_homogeneous=True, margin_top=9)
    pages.append_page(grid, Gtk.Label(label="Overview"))
    widgets = []

    cards = (("CPU", 1, "0–100%"), ("RAM", 1, "0–100%"),
             ("CPU TEMPERATURE", 110, "0–110 °C"), ("BATTERY", None, ""))
    for index, (label, ceiling, units) in enumerate(cards):
        card = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=7)
        card.get_style_context().add_class("destination")
        grid.attach(card, index % 2, index // 2, 1, 1)
        card.pack_start(Gtk.Label(label=label, xalign=0), False, False, 0)
        value = Gtk.Label(xalign=0)
        value.get_style_context().add_class("monitor-value")
        card.pack_start(value, False, False, 0)
        detail = Gtk.Label(xalign=0, wrap=True)
        card.pack_start(detail, False, False, 0)
        meter = Gtk.LevelBar.new_for_interval(0, 10)
        meter.set_mode(Gtk.LevelBarMode.DISCRETE)
        meter.set_no_show_all(True)
        card.pack_end(meter, False, False, 0)
        history = deque()
        trend = None
        if ceiling is not None:
            trend = Gtk.DrawingArea()
            trend.set_size_request(-1, 58)
            trend.connect("draw", draw_trend, history, ceiling)
            card.pack_start(trend, True, True, 0)
            legend = Gtk.Label(label=f"Last 60 s  ·  {units}", xalign=0)
            card.pack_start(legend, False, False, 0)
        widgets.append((value, detail, meter, trend, history))

    process_page = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_top=9)
    pages.append_page(process_page, Gtk.Label(label="Top Processes"))
    toolbar = Gtk.Box(spacing=8)
    process_page.pack_start(toolbar, False, False, 0)
    toolbar.pack_start(Gtk.Label(label="Sort by"), False, False, 0)
    sort = Gtk.ComboBoxText()
    sort.append("cpu", "CPU")
    sort.append("ram", "RAM")
    sort.set_active_id("cpu")
    toolbar.pack_start(sort, False, False, 0)

    store = Gtk.ListStore(str, int, str, str)
    table = Gtk.TreeView(model=store)
    for index, title in enumerate(("Process", "PID", "CPU", "RAM · RSS")):
        renderer = Gtk.CellRendererText()
        if index:
            renderer.set_property("xalign", 1)
        column = Gtk.TreeViewColumn(title, renderer, text=index)
        if index == 0:
            column.set_expand(True)
        table.append_column(column)
    scroll = Gtk.ScrolledWindow(min_content_height=250)
    scroll.add(table)
    process_page.pack_start(scroll, True, True, 0)
    detail = Gtk.Label(label="CPU is relative to one logical core. RSS includes shared memory.",
                       xalign=0, wrap=True)
    process_page.pack_start(detail, False, False, 0)

    before = None
    previous_processes = {}
    previous_time = None
    process_rows = None

    def render_processes(*_):
        if process_rows is None:
            return
        store.clear()
        for name, pid, cpu, resident in rank_processes(*process_rows, sort.get_active_id()):
            cpu_text = "—" if cpu is None else f"{cpu:.1f}%"
            store.append((name, pid, cpu_text, f"{resident / 1024**2:.1f} MiB"))

    def refresh_processes():
        nonlocal previous_processes, previous_time, process_rows
        current = process_sample()
        now = monotonic()
        elapsed = now - previous_time if previous_time is not None else 0
        process_rows = previous_processes, current, elapsed
        previous_processes, previous_time = current, now
        render_processes()

    def switch_page(_, __, index):
        nonlocal previous_time, previous_processes, process_rows
        if index == 1:
            refresh_processes()
        else:
            previous_processes, previous_time, process_rows = {}, None, None

    sort.connect("changed", render_processes)
    pages.connect("switch-page", switch_page)

    def refresh():
        nonlocal before
        after = cpu_counters()
        now = monotonic()
        for (value, detail, meter, trend, history), reading in zip(widgets, readings(before, after)):
            value.set_text(reading.value)
            detail.set_text(reading.detail)
            meter.set_visible(reading.fraction is not None)
            if reading.fraction is not None:
                meter.set_value(round(reading.fraction * 10))
            if trend is not None:
                sample = reading.degrees if reading.label == "CPU TEMPERATURE" else reading.fraction
                history.append((now, sample))
                while history[0][0] < now - HISTORY_SECONDS:
                    history.popleft()
                trend.queue_draw()
        before = after
        if pages.get_current_page() == 1:
            refresh_processes()
        return GLib.SOURCE_CONTINUE

    window.show_all()
    refresh()
    GLib.timeout_add_seconds(1, refresh)
    Gtk.main()


if __name__ == "__main__":
    if sys.argv[1:] == ["--status"]:
        from dataclasses import asdict
        from time import sleep
        before = cpu_counters()
        sleep(0.25)
        print(json.dumps([asdict(item) for item in readings(before, cpu_counters())]))
    else:
        launch()
