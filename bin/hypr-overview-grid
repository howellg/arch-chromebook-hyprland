#!/usr/bin/env python3
"""Show current-workspace windows and thumbnails captured before the panel opens."""
from concurrent.futures import ThreadPoolExecutor
import json
import re
import subprocess
import sys

from galactic_panel import Gtk, heading, panel
from gi.repository import GLib, GdkPixbuf, Pango


def run(*args):
    try:
        return subprocess.check_output(args, stderr=subprocess.DEVNULL, timeout=3)
    except (OSError, subprocess.SubprocessError):
        return b""


def workspace_windows():
    active = json.loads(run("hyprctl", "activeworkspace", "-j") or b"{}")
    windows = json.loads(run("hyprctl", "clients", "-j") or b"[]")
    return [item for item in windows if item.get("mapped") and
            item.get("workspace", {}).get("id") == active.get("id") and
            re.fullmatch(r"0x[0-9a-f]+", item.get("address", "")) and
            item.get("class") != "hypr-overview-grid"]


def shot(item):
    if not item.get("visible", not item.get("hidden")):
        return b""
    x, y = item["at"]
    width, height = item["size"]
    if min(width, height) < 30:
        return b""
    return run("grim", "-s", "0.45", "-l", "1", "-g", f"{x},{y} {width}x{height}", "-")


def thumbnail(data):
    if not data:
        return None
    try:
        loader = GdkPixbuf.PixbufLoader.new_with_type("png")
        loader.write(data)
        loader.close()
        pixbuf = loader.get_pixbuf()
        scale = min(232 / pixbuf.get_width(), 130 / pixbuf.get_height())
        return pixbuf.scale_simple(max(1, round(pixbuf.get_width() * scale)),
                                   max(1, round(pixbuf.get_height() * scale)),
                                   GdkPixbuf.InterpType.BILINEAR)
    except GLib.Error:
        return None


def main():
    windows = workspace_windows()
    if "--list" in sys.argv:
        for item in windows:
            print(item["class"], item["workspace"]["name"], item["title"])
        return
    with ThreadPoolExecutor(max_workers=4) as pool:
        previews = list(pool.map(shot, windows))
    window = panel("Tactical Window Overview", 820, 530)
    root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
    window.add(root)
    root.pack_start(heading("\ue905   TACTICAL WINDOW OVERVIEW"), False, False, 0)
    if not windows:
        root.pack_start(Gtk.Label(label="No windows on this workspace"), True, True, 0)
    else:
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.NEVER, Gtk.PolicyType.AUTOMATIC)
        root.pack_start(scroll, True, True, 0)
        flow = Gtk.FlowBox(row_spacing=8, column_spacing=8, max_children_per_line=3,
                           selection_mode=Gtk.SelectionMode.NONE, valign=Gtk.Align.START)
        scroll.add(flow)

        def focus(_, address):
            subprocess.Popen(["hyprctl", "dispatch",
                              f'hl.dsp.focus({{ window = "address:{address}" }})'])
            window.close()

        for item, data in zip(windows, previews):
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=5)
            pixbuf = thumbnail(data)
            preview = Gtk.Image.new_from_pixbuf(pixbuf) if pixbuf else (
                Gtk.Image.new_from_icon_name("application-x-executable", Gtk.IconSize.DIALOG))
            preview.set_size_request(232, 134)
            box.pack_start(preview, False, False, 0)
            title = item.get("title") or item.get("class") or "Untitled"
            label = Gtk.Label(label=title, ellipsize=Pango.EllipsizeMode.END, max_width_chars=29)
            box.pack_start(label, False, False, 0)
            button = Gtk.Button(tooltip_text=title)
            button.add(box)
            button.connect("clicked", focus, item["address"])
            flow.add(button)
    window.show_all()
    Gtk.main()


if __name__ == "__main__":
    main()
